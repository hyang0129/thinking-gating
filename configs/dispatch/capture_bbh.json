{
  "_comment": [
    "BBH: 20 items from each of 27 subtasks, the suite built because CoT flips it.",
    "Queue: python scripts/dispatch/queue.py expand configs/dispatch/capture_bbh.json",
    "Thinking budget 3072 -> 4096: 0% truncated at 3072; headroom for harder subtasks."
  ],
  "name": "capture_bbh",
  "kind": "python_script",
  "script": "scripts/capture_inference_thinking.py",
  "constants": {
    "out": "shared/icr_capture/bbh_thinking_qwen3",
    "model": "Qwen/Qwen3-8B",
    "shard_count": "4"
  },
  "grid": {
    "shard": [
      "00",
      "01",
      "02",
      "03"
    ]
  },
  "cell_id_template": "capture-bbh-shard{shard}",
  "args": [
    "--task",
    "bbh",
    "--model",
    "{model}",
    "--out-dir",
    "{out}",
    "--max-samples",
    "0",
    "--batch-size",
    "16",
    "--max-prompt-len",
    "1024",
    "--max-response-len",
    "320",
    "--max-response-len-thinking",
    "4096",
    "--chat-template",
    "--shard-index",
    "{shard}",
    "--shard-count",
    "{shard_count}"
  ],
  "output_check": [
    "{out}/meta.shard{shard}.jsonl",
    "{out}/activations_thinking_off.shard{shard}.npz",
    "{out}/activations_thinking_on.shard{shard}.npz"
  ],
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "CUDA_MPS_PIPE_DIRECTORY": "/no/such/path"
  },
  "timeout_s": 43200,
  "max_attempts": 2,
  "priority": 10,
  "tags": [
    "capture",
    "bbh"
  ]
}
