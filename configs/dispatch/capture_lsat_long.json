{
  "_comment": [
    "LSAT with an 8192-token thinking budget.",
    "At 3072, 187/230 responses were truncated mid-reasoning, so",
    "their not_helped labels reflected the cap, not the model."
  ],
  "name": "capture_lsat_long",
  "kind": "python_script",
  "script": "scripts/capture_inference_thinking.py",
  "constants": {
    "out": "shared/icr_capture/lsat_long_thinking_qwen3",
    "model": "Qwen/Qwen3-8B",
    "shard_count": "4"
  },
  "grid": {
    "shard": [
      "00",
      "01",
      "02",
      "03"
    ]
  },
  "cell_id_template": "capture-lsatlong-shard{shard}",
  "args": [
    "--task",
    "lsat",
    "--model",
    "{model}",
    "--out-dir",
    "{out}",
    "--max-samples",
    "0",
    "--batch-size",
    "8",
    "--max-prompt-len",
    "1024",
    "--max-response-len",
    "320",
    "--max-response-len-thinking",
    "8192",
    "--chat-template",
    "--shard-index",
    "{shard}",
    "--shard-count",
    "{shard_count}"
  ],
  "output_check": [
    "{out}/meta.shard{shard}.jsonl",
    "{out}/activations_thinking_off.shard{shard}.npz",
    "{out}/activations_thinking_on.shard{shard}.npz"
  ],
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "CUDA_MPS_PIPE_DIRECTORY": "/no/such/path"
  },
  "timeout_s": 43200,
  "max_attempts": 2,
  "priority": 5,
  "tags": [
    "capture",
    "lsat"
  ]
}
