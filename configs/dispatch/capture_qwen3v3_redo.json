{
  "_comment": [
    "V3 REDO (2026-09-11) -- Qwen3-8B on LSAT, the one Qwen3 task that did not survive v3.",
    "All 4 shards quarantined at 1024: thinking-OFF truncation 76-84%. Qwen3's non-thinking",
    "mode writes very long answers on LSAT, so 1024 -> 4096. Batch 8 for the longer sequences.",
    "Same slug and output dir as capture_qwen3v3; the previous dir was moved to",
    "shared/icr_capture/_superseded/lsat_thinking_qwen3v3.off1024 before this was queued.",
    "Thinking-ON budget unchanged (8192).",
    "Queue: python scripts/dispatch/queue.py expand configs/dispatch/capture_qwen3v3_redo.json"
  ],
  "name": "capture_qwen3v3_redo",
  "kind": "python_script",
  "script": "scripts/capture_inference_thinking.py",
  "constants": {
    "model": "Qwen/Qwen3-8B",
    "slug": "qwen3v3",
    "out": "shared/icr_capture/{tslug}_thinking_{slug}",
    "shard_count": "4"
  },
  "grid": {
    "shard": [
      "00",
      "01",
      "02",
      "03"
    ]
  },
  "zip": {
    "task": [
      "lsat"
    ],
    "tslug": [
      "lsat"
    ],
    "think": [
      "8192"
    ],
    "off": [
      "4096"
    ],
    "maxs": [
      "0"
    ],
    "batch": [
      "8"
    ]
  },
  "cell_id_template": "capture-{slug}-{tslug}-shard{shard}",
  "args": [
    "--task",
    "{task}",
    "--model",
    "{model}",
    "--out-dir",
    "{out}",
    "--max-samples",
    "{maxs}",
    "--batch-size",
    "{batch}",
    "--max-prompt-len",
    "1024",
    "--max-response-len",
    "{off}",
    "--max-response-len-thinking",
    "{think}",
    "--chat-template",
    "--shard-index",
    "{shard}",
    "--shard-count",
    "{shard_count}",
    "--capture-logprobs"
  ],
  "output_check": [
    "{out}/meta.shard{shard}.jsonl",
    "{out}/activations_thinking_off.shard{shard}.npz",
    "{out}/activations_thinking_on.shard{shard}.npz"
  ],
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_DATASETS_OFFLINE": "1",
    "CUDA_MPS_PIPE_DIRECTORY": "/no/such/path"
  },
  "timeout_s": 43200,
  "max_attempts": 2,
  "priority": 5,
  "tags": [
    "capture",
    "v3",
    "truncation-fix",
    "redo",
    "qwen3v3"
  ]
}
